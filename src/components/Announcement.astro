---
import plakat1x from '../assets/site/Wichtelweg_Plakat_freigestellt.webp?url';
import plakat2x from '../assets/site/Wichtelweg_Plakat_freigestellt@2x.webp?url';
---

<section class="info" aria-labelledby="info-title">
	<figure class="info__figure">
		<img
			src={plakat1x}
			srcset={`${plakat1x} 1x, ${plakat2x} 2x`}
			width="500"
			alt="Westhofener Wichtelweg: ab 21.11., kostenfrei, 2,5 km Rundweg für die ganze Familie"
			class="info__art"
			decoding="async"
			loading="lazy"
		/>
		<figcaption class="visually-hidden">
			<h2 id="info-title">Ein besonderer Weg für die ganze Familie</h2>
			<p>
				Ab 21.11. bis 10.01. — Gemeinsam den Zauber der Weihnachtszeit erleben. Kostenfrei. 2,5 km langer
				Rundweg, kinderwagengeeignet.
			</p>
		</figcaption>
	</figure>
</section>

<style>
	.info {
		padding: clamp(1.25rem, 3.5vw, 2.25rem) 1rem 0.5rem;
		display: flex;
		justify-content: center;
	}

	.info__figure {
		margin: 0 auto;
		max-width: min(92vw, 28rem);
		width: 100%;
		display: flex;
		justify-content: center;
	}

	.info__art {
		width: 100%;
		max-width: 500px;
		height: auto;
		display: block;
		margin-inline: auto;
		filter: drop-shadow(0 12px 24px rgba(42, 28, 16, 0.28));
	}
</style>
