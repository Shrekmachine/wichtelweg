---
import { Image } from 'astro:assets';
import heroDock from '../assets/site/hero-dock.jpg';
---

<header class="hero" id="start">
	<div class="hero__media">
		<Image
			src={heroDock}
			alt="Ein Wichtel angelt am Steg vor dem leuchtenden Wichteldorf im Abendlicht"
			widths={[640, 960, 1280, 1800]}
			sizes="100vw"
			class="hero__img"
			priority
		/>
	</div>
	<h1 class="visually-hidden">Westhofener Wichtelweg</h1>
</header>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		min-height: clamp(18rem, 56vw, 30rem);
		overflow: hidden;
		background: #2a1810;
	}

	.hero__media {
		position: absolute;
		inset: 0;
	}

	.hero__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
	}
</style>
