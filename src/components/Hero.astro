---
import { Image } from 'astro:assets';
import heroDock from '../assets/site/hero-dock.jpg';
import waveGnome from '../assets/site/sprites/a02.png';
---

<header class="hero" id="start">
	<div class="hero__media">
		<Image
			src={heroDock}
			alt="Ein Wichtel angelt am Steg vor dem leuchtenden Wichteldorf im Abendlicht"
			widths={[640, 960, 1280, 1800]}
			sizes="100vw"
			class="hero__img"
			priority
		/>
	</div>
	<Image
		src={waveGnome}
		alt=""
		aria-hidden="true"
		class="hero__wave-gnome"
		widths={[140, 200, 260]}
		sizes="140px"
	/>
	<h1 class="visually-hidden">Westhofener Wichtelweg</h1>
</header>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		min-height: clamp(18rem, 56vw, 30rem);
		overflow: hidden;
		background: #2a1810;
	}

	.hero__media {
		position: absolute;
		inset: 0;
	}

	.hero__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
	}

	.hero__wave-gnome {
		position: absolute;
		left: clamp(0.5rem, 3vw, 1.5rem);
		bottom: clamp(0.25rem, 2vw, 1rem);
		width: clamp(4.5rem, 9vw, 6.5rem);
		height: auto;
		filter: drop-shadow(0 6px 12px rgba(20, 10, 5, 0.4));
	}

	@media (max-width: 640px) {
		.hero__wave-gnome {
			display: none;
		}
	}
</style>
