---
import { Image } from 'astro:assets';
import heroWinter from '../assets/site/hero-winter.jpg';
import logoUrl from '../assets/site/logo-westhofener-wichtelweg.png?url';
---

<header class="hero" id="start">
	<div class="hero__media">
		<Image
			src={heroWinter}
			alt="Ein Kinderwichtel angelt am verschneiten Steg vor dem leuchtenden Wichteldorf im Winterabendlicht"
			widths={[640, 960, 1280, 1800]}
			sizes="100vw"
			class="hero__img"
			priority
		/>
		<div class="hero__veil" aria-hidden="true"></div>
	</div>
	<div class="hero__title">
		<h1 class="visually-hidden">Westhofener Wichtelweg</h1>
		<img
			src={logoUrl}
			alt=""
			aria-hidden="true"
			class="hero__logo"
			width="720"
			height="360"
		/>
	</div>
</header>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		min-height: clamp(18rem, 52vw, 32rem);
		overflow: hidden;
		background: #1a2430;
	}

	.hero__media {
		position: absolute;
		inset: 0;
	}

	.hero__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 55%;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 55% 38% at 50% 28%, rgba(20, 12, 8, 0.32), transparent 70%);
		pointer-events: none;
	}

	.hero__title {
		position: absolute;
		z-index: 2;
		left: 0;
		right: 0;
		top: clamp(0.35rem, 1.5vw, 0.85rem);
		display: flex;
		justify-content: center;
		padding: 0 1rem;
		pointer-events: none;
	}

	.hero__logo {
		display: block;
		width: min(96vw, 76rem);
		height: auto;
		max-height: clamp(11rem, 36vw, 19rem);
		object-fit: contain;
	}
</style>
