---
import { Image } from 'astro:assets';
import flowerBorder from '../assets/site/flower-border.png';

const team = [
	'Judith Moser',
	'Lilija Kehrgard',
	'Sabrina Gau',
	'Verena Schwan',
	'Julia Heinemann',
	'Sarah',
	'Arno Weber',
];
---

<footer class="footer" id="impressum">
	<div class="footer__stage">
		<div class="footer__scroll">
			<div class="footer__legal">
				<h2 class="footer__title script">Impressum</h2>
				<p class="footer__mail">
					<a href="mailto:westhofenerwichtel@gmx.de">westhofenerwichtel@gmx.de</a>
				</p>
				<p class="footer__social">
					<a href="https://www.instagram.com/westhofenerwichtel/" rel="noopener noreferrer" target="_blank"
						>Instagram @westhofenerwichtel</a
					>
					<span aria-hidden="true"> · </span>
					<a
						href="https://www.facebook.com/profile.php?id=61580363623028"
						rel="noopener noreferrer"
						target="_blank">Facebook</a
					>
				</p>
			</div>
			<div class="footer__team">
				<p class="footer__team-label">Wichtelweg-Team</p>
				<ul class="footer__names">
					{team.map((name) => <li>{name}</li>)}
				</ul>
			</div>
		</div>
	</div>
	<Image
		src={flowerBorder}
		alt=""
		aria-hidden="true"
		class="footer__flowers"
		widths={[800, 1200, 1600, 2000]}
		sizes="100vw"
	/>
</footer>

<style>
	.footer {
		position: relative;
		margin-top: 2.5rem;
		padding: 2rem 1rem 0;
		overflow: hidden;
		background:
			linear-gradient(180deg, transparent 0%, rgba(90, 130, 70, 0.12) 35%, #4a7240 100%);
	}

	.footer__flowers {
		/* Shown at its full, natural height (no object-fit crop) and pulled up
		   with a negative margin so the Impressum card's bottom overlaps its
		   top edge — z-index below .footer__scroll so the opaque card always
		   paints over it, never the other way round. */
		position: relative;
		z-index: 0;
		display: block;
		width: 100%;
		height: auto;
		margin-top: -3.5rem;
		pointer-events: none;
	}

	.footer__stage {
		position: relative;
		max-width: 58rem;
		margin: 0 auto;
		padding: 1.5rem 1rem 0;
	}

	.footer__scroll {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		gap: 1.25rem;
		margin: 0 auto 2.5rem;
		padding: 1.4rem 1.5rem 1.6rem;
		color: var(--color-ink);
		background:
			radial-gradient(ellipse at 18% 0%, rgba(255, 255, 255, 0.35), transparent 55%),
			linear-gradient(145deg, var(--color-parchment) 0%, #ead7b4 55%, var(--color-parchment-deep) 100%);
		border: 2px solid #c4a574;
		border-radius: 1.1rem;
		box-shadow:
			var(--shadow-soft),
			inset 0 0 0 1px rgba(255, 248, 230, 0.5);
	}

	.footer__title {
		margin: 0 0 0.5rem;
		font-size: 2rem;
	}

	.footer__mail,
	.footer__social,
	.footer__team-label {
		margin: 0.35rem 0;
	}

	.footer__team-label {
		font-weight: 700;
	}

	.footer__names {
		list-style: none;
		margin: 0.35rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.15rem;
		max-width: 28rem;
	}

	.footer__names li:not(:last-child)::after {
		content: ' ·';
		margin-left: 0.35rem;
		opacity: 0.55;
	}

	.footer a {
		color: var(--color-forest);
		font-weight: 600;
	}

	@media (max-width: 720px) {
		.footer__scroll {
			grid-template-columns: 1fr;
		}
	}
</style>
