---
import { Image } from 'astro:assets';
import lantern from '../assets/site/decor-lantern-grass.png';
import mushrooms from '../assets/site/decor-mushrooms-grass.png';
import flowerBorder from '../assets/site/flower-border.png';

const team = [
	'Judith Moser',
	'Lilija Kehrgard',
	'Sabrina Gau',
	'Verena Schwan',
	'Julia Heinemann',
	'Sarah',
	'Arno Weber',
];
---

<footer class="footer" id="impressum">
	<div class="footer__stage">
		<Image
			src={lantern}
			alt=""
			class="footer__decor footer__decor--lantern"
			widths={[220, 320]}
			sizes="160px"
			aria-hidden="true"
		/>
		<Image
			src={mushrooms}
			alt=""
			class="footer__decor footer__decor--mushrooms"
			widths={[220, 320]}
			sizes="160px"
			aria-hidden="true"
		/>

		<div class="footer__scroll">
			<div class="footer__legal">
				<h2 class="footer__title script">Impressum</h2>
				<p class="footer__mail">
					<a href="mailto:westhofenerwichtel@gmx.de">westhofenerwichtel@gmx.de</a>
				</p>
				<p class="footer__social">
					<a href="https://www.instagram.com/westhofenerwichtel/" rel="noopener noreferrer" target="_blank"
						>Instagram @westhofenerwichtel</a
					>
					<span aria-hidden="true"> · </span>
					<a
						href="https://www.facebook.com/profile.php?id=61580363623028"
						rel="noopener noreferrer"
						target="_blank">Facebook</a
					>
				</p>
			</div>
			<div class="footer__team">
				<p class="footer__team-label">Wichtelweg-Team</p>
				<ul class="footer__names">
					{team.map((name) => <li>{name}</li>)}
				</ul>
			</div>
		</div>
	</div>
	<Image
		src={flowerBorder}
		alt=""
		aria-hidden="true"
		class="footer__flowers"
		widths={[800, 1200, 1600, 2000]}
		sizes="100vw"
	/>
</footer>

<style>
	.footer {
		position: relative;
		margin-top: 2.5rem;
		padding: 2rem 1rem 0;
		overflow: hidden;
		background:
			linear-gradient(180deg, transparent 0%, rgba(90, 130, 70, 0.12) 35%, #4a7240 100%);
	}

	.footer__flowers {
		display: block;
		width: 100%;
		height: clamp(3.5rem, 9vw, 6rem);
		object-fit: cover;
		object-position: center 30%;
		pointer-events: none;
	}

	.footer__stage {
		/* flow-root: without this, footer__scroll's bottom margin collapses
		   straight through (no padding/border-bottom here to stop it), so the
		   stage's auto height ends at the card's edge instead of past its
		   margin — which put the decor (anchored at bottom:0) behind the card. */
		display: flow-root;
		position: relative;
		max-width: 58rem;
		margin: 0 auto;
		padding: 1.5rem 1rem 0;
	}

	.footer__decor {
		position: absolute;
		/* Below .footer__scroll (z-index: 1): the opaque Impressum card must always
		   paint over the decor, never the other way round, so team names/links
		   stay fully legible even where the two boxes' bounds overlap. */
		z-index: 0;
		/* Kept well under footer__scroll's bottom margin (7rem) below, so the
		   decor sits fully in the grass gap under the card, never behind it. */
		width: clamp(4rem, 13vw, 6rem);
		height: auto;
		pointer-events: none;
		filter: drop-shadow(0 8px 14px rgba(30, 20, 10, 0.25));
		/* Die Quellbilder haben keinen Alpha-Kanal (fester Pergament-Hintergrund) –
		   Kanten weich in den grünen Footer-Verlauf ausblenden statt hartes Rechteck zu zeigen. */
		mask-image: radial-gradient(ellipse 62% 62% at 50% 58%, black 58%, transparent 96%);
		-webkit-mask-image: radial-gradient(ellipse 62% 62% at 50% 58%, black 58%, transparent 96%);
	}

	.footer__decor--lantern {
		left: -0.25rem;
		bottom: 0;
	}

	.footer__decor--mushrooms {
		right: -0.25rem;
		bottom: 0;
	}

	.footer__scroll {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		gap: 1.25rem;
		margin: 0 auto 7rem;
		padding: 1.4rem 1.5rem 1.6rem;
		color: var(--color-ink);
		background:
			radial-gradient(ellipse at 18% 0%, rgba(255, 255, 255, 0.35), transparent 55%),
			linear-gradient(145deg, var(--color-parchment) 0%, #ead7b4 55%, var(--color-parchment-deep) 100%);
		border: 2px solid #c4a574;
		border-radius: 1.1rem;
		box-shadow:
			var(--shadow-soft),
			inset 0 0 0 1px rgba(255, 248, 230, 0.5);
	}

	.footer__title {
		margin: 0 0 0.5rem;
		font-size: 2rem;
	}

	.footer__mail,
	.footer__social,
	.footer__team-label {
		margin: 0.35rem 0;
	}

	.footer__team-label {
		font-weight: 700;
	}

	.footer__names {
		list-style: none;
		margin: 0.35rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.15rem;
		max-width: 28rem;
	}

	.footer__names li:not(:last-child)::after {
		content: ' ·';
		margin-left: 0.35rem;
		opacity: 0.55;
	}

	.footer a {
		color: var(--color-forest);
		font-weight: 600;
	}

	@media (max-width: 720px) {
		.footer__scroll {
			grid-template-columns: 1fr;
		}

		.footer__decor {
			width: clamp(3rem, 16vw, 4.5rem);
		}
	}
</style>
