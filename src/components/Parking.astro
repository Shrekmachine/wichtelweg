---
import { Image } from 'astro:assets';
import parkingBand from '../assets/site/parkplaetze-band.jpg';
---

<section class="parking" id="parkplaetze" aria-labelledby="parking-title">
	<div class="parking__board">
		<Image
			src={parkingBand}
			alt="Parkplätze: Sonntags erlaubt bei REWE, Netto und Schulhof"
			widths={[640, 960, 1280]}
			sizes="min(58rem, 100vw)"
			class="parking__art"
		/>
	</div>
	<h2 id="parking-title" class="visually-hidden">Parkplätze</h2>
</section>

<style>
	.parking {
		padding: 1.75rem 1rem 0.5rem;
	}

	.parking__board {
		max-width: 58rem;
		margin: 0 auto;
	}

	.parking__art {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 0.5rem;
		filter: drop-shadow(0 12px 22px rgba(40, 22, 10, 0.28));
	}
</style>
