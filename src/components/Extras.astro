---
import { Image } from 'astro:assets';
import comicsBoard from '../assets/site/comics-board.png';
import lantern from '../assets/site/decor-lantern-grass.png';
import mushrooms from '../assets/site/decor-mushrooms-grass.png';
import peekingGnome from '../assets/site/sprites/c03.png';
import CornerDecor from './CornerDecor.astro';
---

<section class="extras" aria-label="Comics und Gewinnspiel">
	<CornerDecor src={mushrooms} corner="left" size="clamp(3.25rem, 6vw, 4.5rem)" bottom="-0.5rem" />
	<CornerDecor src={lantern} corner="right" size="clamp(3.25rem, 6vw, 4.5rem)" bottom="-0.5rem" />
	<article class="extras__comics" id="comics">
		<h2 class="visually-hidden">Comics — Coming soon</h2>
		<Image
			src={comicsBoard}
			alt="Holzschild mit der Aufschrift Coming soon, einem offenen Buch und einem neugierigen Wichtel"
			widths={[495, 740, 990]}
			sizes="(max-width: 760px) 92vw, 420px"
			class="extras__comics-art"
		/>
		<Image
			src={peekingGnome}
			alt=""
			aria-hidden="true"
			class="extras__peeker"
			widths={[110, 160, 220]}
			sizes="110px"
		/>
	</article>

	<article class="extras__game">
		<div class="extras__game-inner">
			<h2 class="extras__title script">Gewinnspiel</h2>
			<p class="extras__text">
				Seid ihr Wichteldetektive? Entlang des Weges warten Buchstaben und eine kleine Überraschung.
			</p>
			<a class="extras__btn" href="/gewinnspiel">Zum Gewinnspiel</a>
		</div>
	</article>
</section>

<style>
	.extras {
		position: relative;
		max-width: 64rem;
		margin: 0 auto;
		padding: 1.75rem 1rem 1rem;
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 1.25rem;
		align-items: center;
	}

	.extras__comics,
	.extras__game {
		position: relative;
		z-index: 1;
	}

	.extras__comics {
		position: relative;
		margin: 0;
		text-align: center;
	}

	.extras__comics-art {
		width: min(100%, 28rem);
		margin-inline: auto;
		height: auto;
		filter: drop-shadow(0 14px 24px rgba(40, 22, 10, 0.22));
	}

	.extras__peeker {
		position: absolute;
		right: clamp(-0.5rem, 4vw, 1.5rem);
		bottom: -0.75rem;
		width: clamp(3rem, 8vw, 4.25rem);
		height: auto;
		filter: drop-shadow(0 8px 10px rgba(40, 22, 10, 0.25));
	}

	@media (max-width: 560px) {
		.extras__peeker {
			display: none;
		}
	}

	.extras__game-inner {
		position: relative;
		padding: 1.35rem 1.25rem 1.5rem;
		color: var(--color-ink);
		background:
			radial-gradient(ellipse at 15% 0%, rgba(255, 255, 255, 0.4), transparent 50%),
			linear-gradient(145deg, var(--color-parchment), var(--color-parchment-deep));
		border: 2px solid #c4a574;
		border-radius: 0.85rem;
		box-shadow: var(--shadow-soft);
	}

	.extras__title {
		margin: 0.2rem 0 0.55rem;
		font-size: clamp(1.9rem, 4vw, 2.5rem);
	}

	.extras__text {
		margin: 0;
		font-size: 0.98rem;
	}

	.extras__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.25rem;
		padding: 0.55rem 1.1rem;
		border-radius: 999px;
		background: var(--color-wood-mid);
		color: var(--color-snow);
		text-decoration: none;
		font-weight: 700;
		box-shadow: 0 4px 0 #2a1810;
		transition:
			transform 0.15s ease,
			background 0.15s ease;
	}

	.extras__btn::after {
		content: '›';
		font-size: 1.2em;
		line-height: 1;
	}

	.extras__btn:hover,
	.extras__btn:focus-visible {
		background: var(--color-wood);
		transform: translateY(1px);
	}

	@media (max-width: 760px) {
		.extras {
			grid-template-columns: 1fr;
		}
	}
</style>
