---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import gewinnspielArt from '../assets/gewinnspiel.jpg';
---

<Layout
	title="Gewinnspiel — Westhofener Wichtelweg"
	description="Alle Regeln zum Wichtel-Gewinnspiel entlang des Westhofener Wichtelwegs."
>
	<SiteNav />
	<main class="gewinnspiel">
		<div class="gewinnspiel__card">
			<a class="gewinnspiel__back" href="/#gewinnspiel">‹ Zurück zur Startseite</a>
			<h1 class="gewinnspiel__title script">Gewinnspiel</h1>
			<Image
				src={gewinnspielArt}
				alt="Hinweis zum Wichtel-Gewinnspiel: Findet die 6 Lösungsbuchstaben an den Wichtelschildern, tragt sie auf der Gewinnspielkarte ein und werft sie in den Briefkasten. Einsendeschluss Ende Januar."
				widths={[480, 720, 960, 1200]}
				sizes="(max-width: 760px) 92vw, 640px"
				class="gewinnspiel__art"
			/>
		</div>
	</main>
	<SiteFooter />
</Layout>

<style>
	.gewinnspiel {
		padding: clamp(1.5rem, 5vw, 3rem) 1rem 2rem;
		max-width: 48rem;
		margin: 0 auto;
	}

	.gewinnspiel__card {
		padding: clamp(1.5rem, 4vw, 2.5rem);
		text-align: center;
		color: var(--color-ink);
		background:
			radial-gradient(ellipse at 18% 0%, rgba(255, 255, 255, 0.35), transparent 55%),
			linear-gradient(135deg, var(--color-parchment) 0%, var(--color-parchment-deep) 55%, #dfc79a 100%);
		border: 2px solid #c4a574;
		border-radius: 1.25rem;
		box-shadow:
			var(--shadow-soft),
			inset 0 0 0 1px rgba(255, 248, 230, 0.55);
	}

	.gewinnspiel__back {
		display: inline-block;
		margin-bottom: 1rem;
		font-weight: 700;
		color: var(--color-forest);
		text-decoration: none;
	}

	.gewinnspiel__back:hover,
	.gewinnspiel__back:focus-visible {
		text-decoration: underline;
	}

	.gewinnspiel__title {
		margin: 0 0 1.25rem;
		font-size: clamp(2.2rem, 6vw, 3rem);
	}

	.gewinnspiel__art {
		width: 100%;
		height: auto;
		border-radius: 0.75rem;
		box-shadow: 0 10px 24px rgba(58, 36, 22, 0.2);
	}
</style>
