---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Westhofener Wichtelweg',
	description = 'Ein märchenhafter Weg voller Wichtel – für Familien und Kinder in Westhofen.',
} = Astro.props;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Grand+Hotel&family=Nunito:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		/* Aus den Team-Grafiken abgeleitet */
		--color-ink: #3b2a1a;
		--color-ink-soft: #5c4030;
		--color-forest: #2a4a32;
		--color-moss: #3d6b45;
		--color-wood: #3a2416;
		--color-wood-mid: #5a3a24;
		--color-wood-light: #7a5234;
		--color-parchment: #f3e6cf;
		--color-parchment-deep: #e8d4b0;
		--color-cream: #faf4e8;
		--color-hat-red: #b83228;
		--color-lantern: #e8b84a;
		--color-snow: #fff8f0;
		--font-script: 'Grand Hotel', 'Segoe Script', cursive;
		--font-body: 'Nunito', system-ui, sans-serif;
		--shadow-soft: 0 10px 28px rgba(58, 36, 22, 0.18);
		--radius-card: 0.35rem;
		--nav-height: 3.4rem;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-height: 100%;
		font-family: var(--font-body);
		color: var(--color-ink);
		background:
			radial-gradient(ellipse 70% 40% at 50% 0%, rgba(232, 184, 74, 0.12), transparent 60%),
			linear-gradient(180deg, #d8c4a0 0%, var(--color-cream) 28%, #e6f0dc 100%);
		line-height: 1.55;
	}

	img {
		max-width: 100%;
		height: auto;
		display: block;
	}

	a {
		color: var(--color-forest);
	}

	h1,
	h2,
	h3,
	.script {
		font-family: var(--font-script);
		font-weight: 400;
		line-height: 1.15;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	:focus-visible {
		outline: 3px solid var(--color-lantern);
		outline-offset: 3px;
	}
</style>
